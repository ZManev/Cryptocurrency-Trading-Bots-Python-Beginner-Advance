# PostgreSQL
POSTGRES_DB=crypto_platform
POSTGRES_USER=crypto
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
POSTGRES_PORT=5432

# Solana Devnet
# Prefer a dedicated authenticated Devnet RPC for CI.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_AIRDROP_LAMPORTS=500000000
SOLANA_CONFIRM_TIMEOUT_MS=90000

# Raydium Devnet E2E
# Official demo route output mint; override if liquidity changes.
RAYDIUM_OUTPUT_MINT=7i5XE77hnx1a6hjWgSuYwmqdmLoDJNTU1rYA6Gqx7QiE
RAYDIUM_SWAP_INPUT_LAMPORTS=10000000
RAYDIUM_SLIPPAGE_BPS=100
