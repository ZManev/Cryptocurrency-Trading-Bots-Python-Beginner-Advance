# Mainnet endpoints. Use a dedicated RPC provider for sustained workloads.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_WS_URL=wss://api.mainnet.solana.com

# Raydium read-only quote parameters (raw token units)
RAYDIUM_INPUT_MINT=So11111111111111111111111111111111111111112
RAYDIUM_OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
RAYDIUM_INPUT_AMOUNT=10000000
RAYDIUM_SLIPPAGE_BPS=50

# Read-only Jito diagnostics
JITO_TIP_ACCOUNTS_URL=https://mainnet.block-engine.jito.wtf/api/v1/getTipAccounts

# Hard safety invariants — do not change in this phase
APP_MODE=READ_ONLY
LIVE_TRADING=false
TRANSACTION_SIGNING_ENABLED=false
SEND_TRANSACTION_ENABLED=false
SEND_BUNDLE_ENABLED=false
